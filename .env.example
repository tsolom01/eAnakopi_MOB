# Optional overrides — defaults come from config/environments.js
#
# Prefer npm scripts:
#   npm run dev   → development API (ECS dev)
#   npm run prod  → production API
#
# Local API (when running eAnakopi_APIs on your machine):
# iOS Simulator:     http://localhost:3000
# Android Emulator:  http://10.0.2.2:3000
#
# EXPO_PUBLIC_API_BASE_URL=http://localhost:3000
# APP_ENV=development
